{
  "name": "@alx/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "dev:ingest": "nest start --watch --path tsconfig.ingest.json --entryFile ingest.main",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:ingest": "node dist-ingest/src/ingest.main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "mongodb": "^6.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@alx/contracts": "*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "mongodb-memory-server-core": "^11.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
